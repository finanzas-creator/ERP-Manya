# Local: VITE_DEV_AUTH=1 usa usuarios de prueba por rol (db/local/usuarios_dev.sql)
VITE_DEV_AUTH=1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=dev
